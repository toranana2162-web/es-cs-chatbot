# Supabase — anon key はクライアントへ公開される想定のキーのみNEXT_PUBLIC_を付与する
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key はサーバー側のみで使用し、絶対にクライアントへ公開しない（SECURITY.md §5）
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — サーバー側のみで使用する（SECURITY.md §5）
ANTHROPIC_API_KEY=

# OpenAI Embeddings（FAQ検索, D-011: text-embedding-3-small）— サーバー側のみで使用する
OPENAI_API_KEY=
